{
  "project": "BeSafe",
  "objective": "Reconhecer um detalhe suspeito e verificar pelo canal conhecido",
  "output": {
    "duration": 20,
    "fps": 30,
    "width": 1440,
    "height": 810,
    "audio": false
  },
  "entities": [
    "email-card",
    "sender-address",
    "cursor",
    "focus-ring"
  ],
  "beats": [
    {
      "start": 0,
      "end": 3,
      "objective": "Apresentar contexto",
      "persistent_entities": [
        "email-card"
      ],
      "focus_target": "subject",
      "action": "reveal",
      "transition": "persistent-card",
      "reading_hold": 1
    },
    {
      "start": 3,
      "end": 7,
      "objective": "Examinar remetente",
      "persistent_entities": [
        "email-card"
      ],
      "focus_target": "sender-address",
      "action": "zoom",
      "transition": "semantic-zoom",
      "reading_hold": 2
    },
    {
      "start": 7,
      "end": 11,
      "objective": "Mostrar detalhe",
      "persistent_entities": [
        "email-card"
      ],
      "focus_target": "sender-address",
      "action": "point",
      "transition": "spotlight",
      "reading_hold": 2
    },
    {
      "start": 11,
      "end": 16,
      "objective": "Retornar ao contexto",
      "persistent_entities": [
        "email-card"
      ],
      "focus_target": "verification",
      "action": "show-known-channel",
      "transition": "zoom-out",
      "reading_hold": 2
    },
    {
      "start": 16,
      "end": 20,
      "objective": "Concluir",
      "persistent_entities": [
        "email-card"
      ],
      "focus_target": "takeaway",
      "action": "hold",
      "transition": "none",
      "reading_hold": 3
    }
  ],
  "invariants": [
    "no-slide-labels",
    "exact-text",
    "one-focus",
    "persistent-identities",
    "fictional-data"
  ]
}
